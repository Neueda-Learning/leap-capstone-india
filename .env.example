# Enterprise Trading Platform, local environment.
#
# Copy this file to .env and fill in the values marked "replace". Configure
# your local orchestration to read it from the repository root. .env is
# git-ignored; .env.example is the template that is committed. Add a variable
# here, without its real value, whenever you add one to your own services.

# --- PostgreSQL ----------------------------------------------------------------

# Database name, user and password for local development. Every service in
# your stack connects to this one database.
POSTGRES_DB=trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

# --- Kafka ---------------------------------------------------------------------

# Bootstrap address for services on your local network. Tools running directly
# on your machine use localhost:9092 instead. See infra/README.md.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# --- Authentication ------------------------------------------------------------

# Shared HS256 signing secret for local development. The auth service signs
# with it and the Trade REST API verifies with it. Keep it at 32 characters or
# more: a short HS256 secret is brute-forceable offline.
JWT_SECRET=dev-only-change-me-this-secret-is-not-for-production-use

# --- Fauxnance API -------------------------------------------------------------

# Base URL of the provided market-data API. Fixed for the programme.
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1

# Your personal Fauxnance key, sent as the X-Api-Key header. The quota is 2000
# requests per day per key. Replace it with the key issued to you. Never commit
# a real key and never let one reach the browser.
FAUXNANCE_API_KEY=replace-with-your-fauxnance-key
